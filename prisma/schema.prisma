generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  email          String     @unique
  password       String
  createDateTime DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  firstName      String
  lastName       String
  username       String     @unique
  id             String     @id @default(uuid()) @db.Uuid
  listings       listing[]

  @@map("users")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model listing {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String   @db.Uuid
  created_at             DateTime @default(now()) @db.Timestamptz(6)
  monthlyRentPrice       Decimal  @db.Decimal(10, 2)
  leaseTitle             String
  leaseDescription       String
  subleaseDurationMonths Int?
  isIndefinite           Boolean  @default(false)
  unitType               String
  livingSpaceType        String
  additionalRoomCount    Int
  subleaseRoomCount      Int
  tenantCount            Int
  bathRoomCount          Int
  unitStatus             String   @default("Available")
  street                 String
  city                   String
  state                  String
  zipCode                String
  freeWifi               Boolean? @default(false)
  freeParking            Boolean? @default(false)
  petFriendly            Boolean? @default(false)
  washerDryer            Boolean? @default(false)
  cookingSpace           Boolean? @default(false)
  imageRefs              String[]
  users                  User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
